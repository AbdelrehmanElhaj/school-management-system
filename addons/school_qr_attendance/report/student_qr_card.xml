<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_report_student_qr_card" model="ir.actions.report">
    <field name="name">بطاقة QR للطالب</field>
    <field name="model">school.student</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">school_qr_attendance.report_student_qr_card</field>
    <field name="report_file">school_qr_attendance.report_student_qr_card</field>
    <field name="binding_model_id" ref="school_management.model_school_student"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="base.paperformat_euro"/>
  </record>

  <template id="report_student_qr_card">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="student">
        <t t-call="web.basic_layout">
          <t t-set="o" t-value="student"/>
          <div style="
            width: 148mm; height: 105mm;
            border: 2px solid #1a1a2e;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            overflow: hidden;
            margin: auto;
            page-break-after: always;
            direction: rtl;
          ">
            <!-- Header bar -->
            <div style="background:#1a1a2e; color:white; padding:6px 12px; display:flex; align-items:center; gap:8px;">
              <span style="font-size:1.2rem; font-weight:bold;">🎓 بطاقة هوية طالب</span>
              <span style="margin-right:auto; font-size:0.75rem; opacity:0.7;">
                <t t-esc="student.school_id.name or 'المدرسة'"/>
              </span>
            </div>
            <!-- Body -->
            <div style="display:flex; flex:1; padding:10px; gap:10px; align-items:center;">
              <!-- Photo -->
              <div style="flex-shrink:0;">
                <t t-if="student.photo">
                  <img t-att-src="'data:image/png;base64,' + student.photo.decode('utf-8') if isinstance(student.photo, bytes) else 'data:image/png;base64,' + student.photo"
                       style="width:60px; height:60px; object-fit:cover; border-radius:50%; border:2px solid #e94560;"/>
                </t>
                <t t-else="">
                  <div style="width:60px;height:60px;border-radius:50%;background:#eee;border:2px solid #e94560;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">👤</div>
                </t>
              </div>
              <!-- Info -->
              <div style="flex:1;">
                <div style="font-size:1rem; font-weight:bold; color:#1a1a2e; margin-bottom:4px;">
                  <t t-esc="student.name"/>
                </div>
                <div style="font-size:0.8rem; color:#555; margin-bottom:2px;">
                  رقم الطالب: <t t-esc="student.student_code"/>
                </div>
                <div style="font-size:0.8rem; color:#555; margin-bottom:2px;">
                  الفصل: <t t-esc="student.class_id.name or '—'"/>
                </div>
                <div style="font-size:0.8rem; color:#555;">
                  المستوى: <t t-esc="student.grade_level or '—'"/>
                </div>
              </div>
              <!-- QR Code -->
              <div style="flex-shrink:0; text-align:center;">
                <t t-if="student.qr_code_image">
                  <img t-att-src="'data:image/png;base64,' + (student.qr_code_image.decode('utf-8') if isinstance(student.qr_code_image, bytes) else student.qr_code_image)"
                       style="width:80px; height:80px;"/>
                </t>
                <div style="font-size:0.65rem; color:#aaa; margin-top:2px;">
                  <t t-esc="student.qr_code or ''"/>
                </div>
              </div>
            </div>
            <!-- Footer -->
            <div style="background:#f5f5f5; padding:4px 12px; font-size:0.7rem; color:#aaa; text-align:center; border-top:1px solid #ddd;">
              نظام إدارة المدرسة — رمز QR للحضور
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>

</odoo>
