<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Teacher Attendance Form -->
  <record id="view_teacher_attendance_form" model="ir.ui.view">
    <field name="name">school.teacher.attendance.form</field>
    <field name="model">school.teacher.attendance</field>
    <field name="arch" type="xml">
      <form string="حضور المعلم">
        <sheet>
          <group>
            <group>
              <field name="teacher_id"/>
              <field name="school_id"/>
              <field name="date"/>
              <field name="source"/>
            </group>
            <group>
              <field name="check_in" widget="datetime"/>
              <field name="check_out" widget="datetime"/>
              <field name="duration" widget="float_time" string="مدة الدوام (ساعات)"/>
              <field name="status" widget="badge"
                     decoration-success="status == 'present'"
                     decoration-warning="status in ('late','half_day')"
                     decoration-danger="status == 'absent'"/>
            </group>
          </group>
          <group string="ملاحظات">
            <field name="notes" nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Teacher Attendance List -->
  <record id="view_teacher_attendance_list" model="ir.ui.view">
    <field name="name">school.teacher.attendance.list</field>
    <field name="model">school.teacher.attendance</field>
    <field name="arch" type="xml">
      <tree string="حضور المعلمين" decoration-danger="status == 'absent'"
            decoration-warning="status in ('late','half_day')">
        <field name="teacher_id"/>
        <field name="school_id"/>
        <field name="date"/>
        <field name="check_in" widget="datetime"/>
        <field name="check_out" widget="datetime"/>
        <field name="duration" widget="float_time"/>
        <field name="status" widget="badge"
               decoration-success="status == 'present'"
               decoration-warning="status in ('late','half_day')"
               decoration-danger="status == 'absent'"/>
        <field name="source"/>
      </tree>
    </field>
  </record>

  <!-- Teacher Attendance Search -->
  <record id="view_teacher_attendance_search" model="ir.ui.view">
    <field name="name">school.teacher.attendance.search</field>
    <field name="model">school.teacher.attendance</field>
    <field name="arch" type="xml">
      <search>
        <field name="teacher_id"/>
        <field name="school_id"/>
        <filter string="اليوم" name="today" domain="[('date','=',context_today().strftime('%Y-%m-%d'))]"/>
        <filter string="حاضر" name="present" domain="[('status','=','present')]"/>
        <filter string="متأخر" name="late" domain="[('status','=','late')]"/>
        <filter string="غائب" name="absent" domain="[('status','=','absent')]"/>
        <group expand="0" string="Group By">
          <filter name="by_teacher" string="المعلم" context="{'group_by': 'teacher_id'}"/>
          <filter name="by_date" string="التاريخ" context="{'group_by': 'date'}"/>
          <filter name="by_school" string="المدرسة" context="{'group_by': 'school_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Teacher Attendance Action -->
  <record id="action_teacher_attendance" model="ir.actions.act_window">
    <field name="name">حضور المعلمين</field>
    <field name="res_model">school.teacher.attendance</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_today': 1}</field>
  </record>

</odoo>
