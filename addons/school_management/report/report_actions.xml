<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Grade Transcript -->
        <record id="action_report_grade_sheet" model="ir.actions.report">
            <field name="name">Grade Report</field>
            <field name="model">school.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">school_management.report_grade_sheet</field>
            <field name="report_file">school_management.report_grade_sheet</field>
            <field name="print_report_name">'Grade Report - ' + (object.name or '')</field>
            <field name="binding_model_id" ref="model_school_student"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Attendance Report -->
        <record id="action_report_attendance" model="ir.actions.report">
            <field name="name">Attendance Report</field>
            <field name="model">school.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">school_management.report_attendance</field>
            <field name="report_file">school_management.report_attendance</field>
            <field name="print_report_name">'Attendance Report - ' + (object.name or '')</field>
            <field name="binding_model_id" ref="model_school_student"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Fee Statement (from student) -->
        <record id="action_report_fee_statement" model="ir.actions.report">
            <field name="name">Fee Statement</field>
            <field name="model">school.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">school_management.report_fee_statement</field>
            <field name="report_file">school_management.report_fee_statement</field>
            <field name="print_report_name">'Fee Statement - ' + (object.name or '')</field>
            <field name="binding_model_id" ref="model_school_student"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Enrollment Certificate -->
        <record id="action_report_enrollment_certificate" model="ir.actions.report">
            <field name="name">Enrollment Certificate</field>
            <field name="model">school.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">school_management.report_enrollment_certificate</field>
            <field name="report_file">school_management.report_enrollment_certificate</field>
            <field name="print_report_name">'Enrollment Certificate - ' + (object.name or '')</field>
            <field name="binding_model_id" ref="model_school_student"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Completion Certificate -->
        <record id="action_report_completion_certificate" model="ir.actions.report">
            <field name="name">Completion Certificate</field>
            <field name="model">school.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">school_management.report_completion_certificate</field>
            <field name="report_file">school_management.report_completion_certificate</field>
            <field name="print_report_name">'Completion Certificate - ' + (object.name or '')</field>
            <field name="binding_model_id" ref="model_school_student"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Payment Receipt -->
        <record id="action_report_receipt" model="ir.actions.report">
            <field name="name">Payment Receipt</field>
            <field name="model">school.fee.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">school_management.report_receipt</field>
            <field name="report_file">school_management.report_receipt</field>
            <field name="print_report_name">'Receipt - ' + (object.payment_code or '')</field>
            <field name="binding_model_id" ref="model_school_fee_payment"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Timetable PDF -->
        <record id="action_report_timetable" model="ir.actions.report">
            <field name="name">Class Timetable</field>
            <field name="model">school.timetable</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">school_management.report_timetable_template</field>
            <field name="report_file">school_management.report_timetable_template</field>
            <field name="print_report_name">'Timetable - ' + (object.display_name or '')</field>
            <field name="binding_model_id" ref="model_school_timetable"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>

    </data>
</odoo>
