<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_receipt_document">
            <t t-foreach="docs" t-as="payment">
                <div class="page" dir="rtl" style="font-family: Arial, 'Amiri', sans-serif; padding: 25px; max-width: 640px; margin: 0 auto;">
                    <t t-call="school_management.school_header"/>

                    <div style="text-align:center; margin-bottom:16px;">
                        <h3 style="margin:0;">إيصال سداد</h3>
                        <p style="margin:4px 0; font-size:14px; color:#555;">
                            رقم الإيصال: <strong><span t-field="payment.payment_code"/></strong>
                        </p>
                    </div>

                    <table style="width:100%; border-collapse:collapse; margin-bottom:16px; font-size:13px;">
                        <tr>
                            <td style="padding:6px; width:35%; color:#666;">تاريخ السداد:</td>
                            <td style="padding:6px; font-weight:bold;"><span t-field="payment.payment_date"/></td>
                        </tr>
                        <tr style="background:#f8f9fa;">
                            <td style="padding:6px; color:#666;">اسم الطالب:</td>
                            <td style="padding:6px; font-weight:bold;">
                                <span t-field="payment.student_id.name"/>
                                (<span t-field="payment.student_id.student_code"/>)
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px; color:#666;">الفصل / العام:</td>
                            <td style="padding:6px;">
                                <t t-esc="payment.fee_id.class_id.display_name or '—'"/>
                                · <t t-esc="payment.fee_id.academic_year_id.name or '—'"/>
                            </td>
                        </tr>
                        <tr style="background:#f8f9fa;">
                            <td style="padding:6px; color:#666;">ولي الأمر:</td>
                            <td style="padding:6px;"><t t-esc="payment.guardian_id.name or '—'"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px; color:#666;">نوع الرسم:</td>
                            <td style="padding:6px;">
                                <span t-field="payment.fee_id.fee_type_id.name"/>
                                (<span t-field="payment.fee_id.fee_code"/>)
                            </td>
                        </tr>
                        <tr style="background:#f8f9fa;" t-if="payment.installment_id">
                            <td style="padding:6px; color:#666;">القسط:</td>
                            <td style="padding:6px;"><span t-field="payment.installment_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px; color:#666;">طريقة السداد:</td>
                            <td style="padding:6px;"><span t-field="payment.payment_method"/></td>
                        </tr>
                        <tr style="background:#f8f9fa;">
                            <td style="padding:6px; color:#666;">المستلم:</td>
                            <td style="padding:6px;"><t t-esc="payment.received_by.name or ''"/></td>
                        </tr>
                    </table>

                    <t t-set="brand_color" t-value="(env.company.primary_color) or '#135c49'"/>
                    <div t-attf-style="background: {{ brand_color }}; color:white; text-align:center; padding:16px; border-radius:6px; margin-bottom:16px;">
                        <div style="font-size:12px; margin-bottom:4px; opacity:0.85;">المبلغ المسدد</div>
                        <div style="font-size:30px; font-weight:bold;" dir="ltr">
                            <t t-esc="'%.2f' % payment.amount"/>
                            <t t-esc="payment.currency_id.symbol"/>
                        </div>
                    </div>

                    <div style="border:1px solid #dee2e6; padding:10px; border-radius:4px; margin-bottom:10px; font-size:13px;">
                        <table style="width:100%;">
                            <tr>
                                <td style="color:#666;">صافي الرسوم المستحق:</td>
                                <td style="text-align:left;" dir="ltr">
                                    <t t-esc="'%.2f' % payment.fee_id.net_payable"/>
                                    <t t-esc="payment.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#27ae60;">إجمالي المسدد:</td>
                                <td style="text-align:left; color:#27ae60;" dir="ltr">
                                    <t t-esc="'%.2f' % payment.fee_id.paid_amount"/>
                                    <t t-esc="payment.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr style="font-weight:bold; border-top:1px solid #dee2e6;">
                                <td t-attf-style="color: #{'#27ae60' if payment.fee_id.balance == 0 else '#e74c3c'};">
                                    الرصيد المتبقي:
                                </td>
                                <td t-attf-style="text-align:left; color: #{'#27ae60' if payment.fee_id.balance == 0 else '#e74c3c'};" dir="ltr">
                                    <t t-esc="'%.2f' % payment.fee_id.balance"/>
                                    <t t-esc="payment.currency_id.symbol"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <t t-if="payment.notes">
                        <p style="font-size:12px; color:#666;"><em>ملاحظات: <t t-esc="payment.notes"/></em></p>
                    </t>

                    <t t-call="school_management.school_footer">
                        <t t-set="doc_number" t-value="payment.payment_code"/>
                    </t>
                </div>
            </t>
        </template>

        <template id="report_receipt">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-call="school_management.report_receipt_document"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
