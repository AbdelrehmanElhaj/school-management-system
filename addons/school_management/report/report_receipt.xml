<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_receipt_document">
            <t t-foreach="docs" t-as="payment">
                <div class="page" dir="rtl" style="font-family: Arial, 'Amiri', sans-serif; padding: 30px; max-width: 600px; margin: 0 auto;">

                    <!-- Receipt Header -->
                    <div style="text-align:center; border-bottom:3px double #2c3e50; padding-bottom:15px; margin-bottom:20px;">
                        <h2 style="color:#2c3e50; margin:0; font-size:24px;">PAYMENT RECEIPT</h2>
                        <p style="margin:5px 0; font-size:16px; color:#555;">
                            Receipt No: <strong><t t-esc="payment.payment_code"/></strong>
                        </p>
                    </div>

                    <!-- Receipt Info Grid -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
                        <tr>
                            <td style="padding:6px; width:40%; color:#666;">Payment Date:</td>
                            <td style="padding:6px; font-weight:bold;">
                                <t t-esc="str(payment.payment_date)"/>
                            </td>
                        </tr>
                        <tr style="background:#f8f9fa;">
                            <td style="padding:6px; color:#666;">Student Name:</td>
                            <td style="padding:6px; font-weight:bold;">
                                <t t-esc="payment.student_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px; color:#666;">Student ID:</td>
                            <td style="padding:6px;">
                                <t t-esc="payment.student_id.student_code"/>
                            </td>
                        </tr>
                        <tr style="background:#f8f9fa;">
                            <td style="padding:6px; color:#666;">Guardian:</td>
                            <td style="padding:6px;">
                                <t t-esc="payment.guardian_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px; color:#666;">Fee Type:</td>
                            <td style="padding:6px;">
                                <t t-esc="payment.fee_id.fee_type_id.name"/>
                            </td>
                        </tr>
                        <tr style="background:#f8f9fa;">
                            <td style="padding:6px; color:#666;">Fee Reference:</td>
                            <td style="padding:6px;">
                                <t t-esc="payment.fee_id.fee_code"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px; color:#666;">Payment Method:</td>
                            <td style="padding:6px;">
                                <t t-esc="payment.payment_method.replace('_',' ').title()"/>
                            </td>
                        </tr>
                        <tr style="background:#f8f9fa;">
                            <td style="padding:6px; color:#666;">Received By:</td>
                            <td style="padding:6px;">
                                <t t-esc="payment.received_by.name or ''"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Amount Box -->
                    <div style="background:#2c3e50; color:white; text-align:center; padding:20px; border-radius:6px; margin-bottom:20px;">
                        <div style="font-size:13px; margin-bottom:5px; opacity:0.8;">AMOUNT PAID</div>
                        <div style="font-size:32px; font-weight:bold;">
                            <t t-esc="'%.2f' % payment.amount"/>
                            <t t-esc="payment.currency_id.symbol"/>
                        </div>
                    </div>

                    <!-- Outstanding Balance -->
                    <div style="border:1px solid #dee2e6; padding:10px; border-radius:4px; margin-bottom:20px; font-size:13px;">
                        <table style="width:100%;">
                            <tr>
                                <td style="color:#666;">Total Fee:</td>
                                <td style="text-align:right;">
                                    <t t-esc="'%.2f' % payment.fee_id.amount"/>
                                    <t t-esc="payment.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#27ae60;">Total Paid:</td>
                                <td style="text-align:right; color:#27ae60;">
                                    <t t-esc="'%.2f' % payment.fee_id.paid_amount"/>
                                    <t t-esc="payment.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr style="font-weight:bold; border-top:1px solid #dee2e6;">
                                <td t-attf-style="color: #{'#27ae60' if payment.fee_id.balance == 0 else '#e74c3c'};">
                                    Outstanding Balance:
                                </td>
                                <td t-attf-style="text-align:right; color: #{'#27ae60' if payment.fee_id.balance == 0 else '#e74c3c'};">
                                    <t t-esc="'%.2f' % payment.fee_id.balance"/>
                                    <t t-esc="payment.currency_id.symbol"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Notes -->
                    <t t-if="payment.notes">
                        <p style="font-size:12px; color:#666;"><em>Notes: <t t-esc="payment.notes"/></em></p>
                    </t>

                    <!-- Footer -->
                    <div style="margin-top:40px; display:flex; justify-content:space-between; font-size:12px;">
                        <div style="text-align:center; width:40%;">
                            <div style="border-top:1px solid #333; padding-top:5px;">Cashier Signature</div>
                        </div>
                        <div style="text-align:center; width:40%;">
                            <div style="border-top:1px solid #333; padding-top:5px;">School Stamp</div>
                        </div>
                    </div>

                    <p style="text-align:center; font-size:11px; color:#aaa; margin-top:20px;">
                        This is a computer-generated receipt. Thank you for your payment.
                    </p>
                </div>
            </t>
        </template>

        <template id="report_receipt">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <t t-call="school_management.report_receipt_document"
                            t-lang="o.env.lang"/>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
