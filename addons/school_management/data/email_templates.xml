<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Fee Reminder Email Template -->
        <record id="email_template_fee_reminder" model="mail.template">
            <field name="name">School: Fee Payment Reminder</field>
            <field name="model_id" ref="school_management.model_school_fee"/>
            <field name="subject">Payment Reminder: {{ object.fee_type_id.name }} - {{ object.student_id.name }}</field>
            <field name="email_to">{{ object.guardian_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #2c3e50;">Payment Reminder</h2>
    <p>Dear {{ object.guardian_id.name }},</p>
    <p>This is a reminder that the following fee is outstanding for <strong>{{ object.student_id.name }}</strong>:</p>
    <table style="width:100%; border-collapse: collapse; margin: 20px 0;">
        <tr style="background-color: #f2f2f2;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Fee Type</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.fee_type_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Term</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.term }}</td>
        </tr>
        <tr style="background-color: #f2f2f2;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Amount Due</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.amount }} {{ object.currency_id.symbol }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Amount Paid</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.paid_amount }} {{ object.currency_id.symbol }}</td>
        </tr>
        <tr style="background-color: #ffe6e6;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Outstanding Balance</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>{{ object.balance }} {{ object.currency_id.symbol }}</strong></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Due Date</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.due_date }}</td>
        </tr>
    </table>
    <p>Please contact the school administration to arrange payment.</p>
    <p>Thank you,<br/><strong>School Administration</strong></p>
</div>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Payment Receipt Email Template -->
        <record id="email_template_payment_receipt" model="mail.template">
            <field name="name">School: Payment Receipt</field>
            <field name="model_id" ref="school_management.model_school_fee_payment"/>
            <field name="subject">Payment Receipt #{{ object.payment_code }} - {{ object.student_id.name }}</field>
            <field name="email_to">{{ object.guardian_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #27ae60;">Payment Received</h2>
    <p>Dear {{ object.guardian_id.name }},</p>
    <p>We confirm receipt of payment for <strong>{{ object.student_id.name }}</strong>:</p>
    <table style="width:100%; border-collapse: collapse; margin: 20px 0;">
        <tr style="background-color: #f2f2f2;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Receipt No.</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.payment_code }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Payment Date</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.payment_date }}</td>
        </tr>
        <tr style="background-color: #f2f2f2;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Amount Paid</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>{{ object.amount }} {{ object.currency_id.symbol }}</strong></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Payment Method</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.payment_method }}</td>
        </tr>
        <tr style="background-color: #f2f2f2;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Remaining Balance</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.fee_id.balance }} {{ object.currency_id.symbol }}</td>
        </tr>
    </table>
    <p>Thank you for your payment.</p>
    <p><strong>School Administration</strong></p>
</div>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Student Enrollment Confirmation Email -->
        <record id="email_template_enrollment" model="mail.template">
            <field name="name">School: Student Enrollment Confirmation</field>
            <field name="model_id" ref="school_management.model_school_student"/>
            <field name="subject">Enrollment Confirmation - {{ object.name }}</field>
            <field name="email_to">{{ object.guardian_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #2980b9;">Enrollment Confirmation</h2>
    <p>Dear {{ object.guardian_id.name }},</p>
    <p>We are pleased to confirm the enrollment of <strong>{{ object.name }}</strong>.</p>
    <table style="width:100%; border-collapse: collapse; margin: 20px 0;">
        <tr style="background-color: #f2f2f2;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Student ID</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.student_code }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Class</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.class_id.display_name }}</td>
        </tr>
        <tr style="background-color: #f2f2f2;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Academic Year</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.academic_year_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Enrollment Date</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.enrollment_date }}</td>
        </tr>
    </table>
    <p>Welcome to our school family!</p>
    <p><strong>School Administration</strong></p>
</div>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Overdue Fee Alert - Scheduled Action -->
        <record id="cron_check_overdue_fees" model="ir.cron">
            <field name="name">School: Daily Overdue Fee Check</field>
            <field name="model_id" ref="school_management.model_school_fee"/>
            <field name="state">code</field>
            <field name="code">
today = fields.Date.today()
overdue_fees = env['school.fee'].search([
    ('state', 'in', ['due', 'partial']),
    ('due_date', '&lt;', today),
])
overdue_fees.write({'state': 'overdue'})
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
