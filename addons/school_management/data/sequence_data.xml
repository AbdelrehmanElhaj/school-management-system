<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_school_student" model="ir.sequence">
            <field name="name">Student ID Sequence</field>
            <field name="code">school.student</field>
            <field name="prefix">STU/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_school_teacher" model="ir.sequence">
            <field name="name">Teacher ID Sequence</field>
            <field name="code">school.teacher</field>
            <field name="prefix">TCH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="seq_school_fee" model="ir.sequence">
            <field name="name">Fee ID Sequence</field>
            <field name="code">school.fee</field>
            <field name="prefix">FEE/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_school_fee_payment" model="ir.sequence">
            <field name="name">Payment Receipt Sequence</field>
            <field name="code">school.fee.payment</field>
            <field name="prefix">RCT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
