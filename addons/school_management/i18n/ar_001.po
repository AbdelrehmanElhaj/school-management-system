#. module: school_management
#: model:mail.template,body_html:school_management.email_template_absence_alert
msgid ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <div style=\"background-color: #e74c3c; padding: 20px; text-align: center;\">\n"
"        <h2 style=\"color: white; margin: 0;\">Absence Notification</h2>\n"
"    </div>\n"
"    <div style=\"padding: 20px; border: 1px solid #ddd;\">\n"
"        <p>Dear {{ object.student_id.guardian_id.name or 'Parent/Guardian' }},</p>\n"
"        <p>We would like to inform you that <strong>{{ object.student_id.name }}</strong>\n"
"           was marked <strong style=\"color:#e74c3c;\">absent</strong> on\n"
"           <strong>{{ object.date }}</strong>.</p>\n"
"        <table style=\"width:100%; border-collapse:collapse; margin:15px 0;\">\n"
"            <tr style=\"background:#f2f2f2;\">\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Student</strong></td>\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\">{{ object.student_id.name }}</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Student ID</strong></td>\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\">{{ object.student_id.student_code }}</td>\n"
"            </tr>\n"
"            <tr style=\"background:#f2f2f2;\">\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Class</strong></td>\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\">{{ object.class_id.display_name }}</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Date</strong></td>\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\">{{ object.date }}</td>\n"
"            </tr>\n"
"            {% if object.notes %}\n"
"            <tr style=\"background:#f2f2f2;\">\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Notes</strong></td>\n"
"                <td style=\"padding:8px; border:1px solid #ddd;\">{{ object.notes }}</td>\n"
"            </tr>\n"
"            {% endif %}\n"
"        </table>\n"
"        <p>If this absence was planned, please contact the school administration with an excuse note.</p>\n"
"        <p>Thank you,<br/><strong>School Administration</strong></p>\n"
"    </div>\n"
"</div>\n"
"        "
msgstr ""

#. module: school_management
#: model:mail.template,body_html:school_management.email_template_payment_receipt
msgid ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <h2 style=\"color: #27ae60;\">Payment Received</h2>\n"
"    <p>Dear {{ object.guardian_id.name }},</p>\n"
"    <p>We confirm receipt of payment for <strong>{{ object.student_id.name }}</strong>:</p>\n"
"    <table style=\"width:100%; border-collapse: collapse; margin: 20px 0;\">\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Receipt No.</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.payment_code }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Payment Date</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.payment_date }}</td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Amount Paid</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>{{ object.amount }} {{ object.currency_id.symbol }}</strong></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Payment Method</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.payment_method }}</td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Remaining Balance</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.fee_id.balance }} {{ object.currency_id.symbol }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    <p>Thank you for your payment.</p>\n"
"    <p><strong>School Administration</strong></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: school_management
#: model:mail.template,body_html:school_management.email_template_enrollment
msgid ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <h2 style=\"color: #2980b9;\">Enrollment Confirmation</h2>\n"
"    <p>Dear {{ object.guardian_id.name }},</p>\n"
"    <p>We are pleased to confirm the enrollment of <strong>{{ object.name }}</strong>.</p>\n"
"    <table style=\"width:100%; border-collapse: collapse; margin: 20px 0;\">\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Student ID</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.student_code }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Class</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.class_id.display_name }}</td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Academic Year</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.academic_year_id.name }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Enrollment Date</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.enrollment_date }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    <p>Welcome to our school family!</p>\n"
"    <p><strong>School Administration</strong></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: school_management
#: model:mail.template,body_html:school_management.email_template_fee_reminder
msgid ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <h2 style=\"color: #2c3e50;\">Payment Reminder</h2>\n"
"    <p>Dear {{ object.guardian_id.name }},</p>\n"
"    <p>This is a reminder that the following fee is outstanding for <strong>{{ object.student_id.name }}</strong>:</p>\n"
"    <table style=\"width:100%; border-collapse: collapse; margin: 20px 0;\">\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Fee Type</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.fee_type_id.name }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Term</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.term }}</td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Amount Due</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.amount }} {{ object.currency_id.symbol }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Amount Paid</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.paid_amount }} {{ object.currency_id.symbol }}</td>\n"
"        </tr>\n"
"        <tr style=\"background-color: #ffe6e6;\">\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Outstanding Balance</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>{{ object.balance }} {{ object.currency_id.symbol }}</strong></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Due Date</strong></td>\n"
"            <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ object.due_date }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    <p>Please contact the school administration to arrange payment.</p>\n"
"    <p>Thank you,<br/><strong>School Administration</strong></p>\n"
"</div>\n"
"            "
msgstr ""

