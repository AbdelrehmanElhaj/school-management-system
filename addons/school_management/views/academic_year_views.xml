<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Academic Year List View -->
        <record id="view_academic_year_list" model="ir.ui.view">
            <field name="name">school.academic.year.list</field>
            <field name="model">school.academic.year</field>
            <field name="arch" type="xml">
                <tree string="Academic Years" decoration-success="state=='active'" decoration-muted="state=='done'">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="school_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="class_count"/>
                    <field name="current"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Academic Year Form View -->
        <record id="view_academic_year_form" model="ir.ui.view">
            <field name="name">school.academic.year.form</field>
            <field name="model">school.academic.year</field>
            <field name="arch" type="xml">
                <form string="Academic Year">
                    <header>
                        <button name="action_activate" string="Activate" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                        <button name="action_close" string="Close Year" type="object"
                            invisible="state != 'active'"/>
                        <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'done'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,active,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_classes" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap">
                                <field name="class_count" widget="statinfo" string="Classes"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Academic Year Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="school_id"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                            <group>
                                <field name="current"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes" placeholder="Additional notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Academic Year Search View -->
        <record id="view_academic_year_search" model="ir.ui.view">
            <field name="name">school.academic.year.search</field>
            <field name="model">school.academic.year</field>
            <field name="arch" type="xml">
                <search string="Search Academic Years">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="school_id"/>
                    <filter string="Active" name="active" domain="[('state','=','active')]"/>
                    <filter string="Current" name="current" domain="[('current','=',True)]"/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Closed" name="closed" domain="[('state','=','done')]"/>
                    <group expand="0" string="Group By">
                        <filter string="School" name="group_school" context="{'group_by': 'school_id'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Academic Year Action -->
        <record id="action_academic_year" model="ir.actions.act_window">
            <field name="name">Academic Years</field>
            <field name="res_model">school.academic.year</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_academic_year_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first academic year
                </p>
            </field>
        </record>

    </data>
</odoo>
