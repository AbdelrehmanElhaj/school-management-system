<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- ════════════════════════════════════════════════════════════
         ANNOUNCEMENTS
    ═══════════════════════════════════════════════════════════════ -->

    <record id="view_announcement_tree" model="ir.ui.view">
        <field name="name">school.announcement.tree</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <tree string="Announcements"
                  decoration-success="state == 'published'"
                  decoration-muted="state == 'archived'">
                <field name="name" string="Title"/>
                <field name="audience"/>
                <field name="date_publish"/>
                <field name="date_expire"/>
                <field name="recipient_count" string="Recipients"/>
                <field name="email_sent" string="Emailed"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_announcement_form" model="ir.ui.view">
        <field name="name">school.announcement.form</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <form string="Announcement">
                <header>
                    <button name="action_publish" string="Publish"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_send_email_now" string="Send Email Now"
                            type="object"
                            invisible="state != 'published'"/>
                    <button name="action_archive_announcement" string="Archive"
                            type="object"
                            invisible="state == 'archived'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users" type="object"
                                name="action_send_email_now"
                                invisible="state != 'published'">
                            <field name="recipient_count" widget="statinfo" string="Recipients"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Announcement Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="audience"/>
                            <field name="date_publish"/>
                            <field name="date_expire"/>
                        </group>
                        <group>
                            <field name="class_ids" widget="many2many_tags"
                                   placeholder="All classes (leave empty for all)"/>
                            <field name="send_email"/>
                            <field name="email_sent" readonly="1"
                                   invisible="not email_sent"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="body" nolabel="1" widget="html"/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_announcement_kanban" model="ir.ui.view">
        <field name="name">school.announcement.kanban</field>
        <field name="model">school.announcement</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state" sample="1">
                <field name="name"/>
                <field name="audience"/>
                <field name="date_publish"/>
                <field name="state"/>
                <field name="email_sent"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-3">
                            <div class="oe_kanban_content">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small mt-1">
                                    <field name="audience"/>
                                    · <field name="date_publish"/>
                                </div>
                                <div class="mt-2">
                                    <field name="state" widget="badge"/>
                                    <t t-if="record.email_sent.raw_value">
                                        <span class="badge bg-success ms-1">Emailed</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">school.announcement</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════
         BULK COMMUNICATION WIZARD
    ═══════════════════════════════════════════════════════════════ -->

    <record id="view_communication_wizard_form" model="ir.ui.view">
        <field name="name">school.communication.wizard.form</field>
        <field name="model">school.communication.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Parent Communication">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Compose and send an email to guardians of selected students or classes.
                    </div>
                    <group>
                        <group string="Recipients">
                            <field name="class_ids" widget="many2many_tags"
                                   placeholder="Select classes…"/>
                            <field name="student_ids" widget="many2many_tags"
                                   placeholder="Add specific students…"/>
                        </group>
                        <group string="Preview">
                            <field name="recipient_count" string="Recipients Found" readonly="1"/>
                            <field name="recipient_preview" widget="text" readonly="1"
                                   nolabel="1" style="font-size:0.8em; max-height:80px; overflow:auto"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="subject" nolabel="1" placeholder="Subject…"/>
                        <field name="body" nolabel="1" widget="html"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send" string="Send Email"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_communication_wizard" model="ir.actions.act_window">
        <field name="name">Send Parent Communication</field>
        <field name="res_model">school.communication.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</data>
</odoo>
