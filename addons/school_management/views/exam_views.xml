<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Exam Tree View -->
        <record id="view_exam_tree" model="ir.ui.view">
            <field name="name">school.exam.tree</field>
            <field name="model">school.exam</field>
            <field name="arch" type="xml">
                <tree string="Exams"
                    decoration-success="state == 'graded'"
                    decoration-muted="state == 'closed'"
                    decoration-info="state == 'confirmed'">
                    <field name="name"/>
                    <field name="exam_type"/>
                    <field name="subject_id"/>
                    <field name="class_id"/>
                    <field name="term"/>
                    <field name="date"/>
                    <field name="max_score"/>
                    <field name="grade_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Exam Form View -->
        <record id="view_exam_form" model="ir.ui.view">
            <field name="name">school.exam.form</field>
            <field name="model">school.exam</field>
            <field name="arch" type="xml">
                <form string="Exam">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_enter_grades" string="Enter Grades" type="object"
                            class="btn-primary" invisible="state not in ('confirmed','graded')"/>
                        <button name="action_close" string="Close" type="object"
                            invisible="state != 'graded'"/>
                        <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('confirmed','graded')"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,confirmed,graded,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_grades" type="object"
                                class="oe_stat_button" icon="fa-list-ol">
                                <field name="grade_count" widget="statinfo" string="Grades"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Exam Name"/></h1>
                        </div>
                        <group>
                            <group string="Exam Details">
                                <field name="exam_type"/>
                                <field name="term"/>
                                <field name="subject_id"/>
                                <field name="class_id"/>
                                <field name="academic_year_id" readonly="1"/>
                            </group>
                            <group string="Scoring">
                                <field name="date"/>
                                <field name="teacher_id"/>
                                <field name="max_score"/>
                                <field name="pass_score"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" placeholder="Exam description, topics covered..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Exam Search View -->
        <record id="view_exam_search" model="ir.ui.view">
            <field name="name">school.exam.search</field>
            <field name="model">school.exam</field>
            <field name="arch" type="xml">
                <search string="Search Exams">
                    <field name="name"/>
                    <field name="subject_id"/>
                    <field name="class_id"/>
                    <field name="teacher_id"/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                    <filter string="Graded" name="graded" domain="[('state','=','graded')]"/>
                    <filter string="Closed" name="closed" domain="[('state','=','closed')]"/>
                    <separator/>
                    <filter string="First Term" name="first" domain="[('term','=','first')]"/>
                    <filter string="Second Term" name="second" domain="[('term','=','second')]"/>
                    <filter string="Third Term" name="third" domain="[('term','=','third')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                        <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'exam_type'}"/>
                        <filter string="Term" name="group_term" context="{'group_by': 'term'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Exam Action -->
        <record id="action_exam" model="ir.actions.act_window">
            <field name="name">Exams</field>
            <field name="res_model">school.exam</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_exam_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first exam
                </p>
            </field>
        </record>

    </data>
</odoo>
