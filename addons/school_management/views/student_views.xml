<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Student List View -->
        <record id="view_student_list" model="ir.ui.view">
            <field name="name">school.student.list</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <tree string="Students"
                    decoration-danger="status == 'withdrawn'"
                    decoration-warning="status == 'transferred'"
                    decoration-info="status == 'paused'"
                    decoration-muted="status == 'graduated'">
                    <field name="student_code"/>
                    <field name="name"/>
                    <field name="gender"/>
                    <field name="class_id"/>
                    <field name="grade_level"/>
                    <field name="guardian_name"/>
                    <field name="guardian_phone"/>
                    <field name="enrollment_date"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <!-- Student Form View -->
        <record id="view_student_form" model="ir.ui.view">
            <field name="name">school.student.form</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <form string="Student">
                    <header>
                        <!-- Enrollment workflow buttons (shown until enrollment is active) -->
                        <button name="action_submit_application"
                            string="تقديم الطلب" type="object"
                            class="btn-primary"
                            invisible="enrollment_state != 'new'"/>
                        <button name="action_submit_documents"
                            string="رفع المستندات" type="object"
                            class="btn-primary"
                            invisible="enrollment_state != 'pending_docs'"/>
                        <button name="action_approve_enrollment"
                            string="قبول التسجيل" type="object"
                            class="btn-success"
                            invisible="enrollment_state != 'pending_approval'"
                            groups="school_management.group_school_admin,school_management.group_school_principal"/>
                        <button name="action_reject_enrollment"
                            string="إعادة الطلب" type="object"
                            class="btn-warning"
                            invisible="enrollment_state != 'pending_approval'"
                            groups="school_management.group_school_admin,school_management.group_school_principal"/>
                        <!-- Enrollment state statusbar (hidden once enrolled) -->
                        <field name="enrollment_state" widget="statusbar"
                            statusbar_visible="new,pending_docs,pending_approval,active"
                            invisible="enrollment_state == 'active'"/>
                        <!-- Operational status buttons (shown only when fully enrolled) -->
                        <button name="action_withdraw" string="Withdraw" type="object"
                            class="btn-danger"
                            invisible="status != 'active' or enrollment_state != 'active'"/>
                        <button name="action_activate" string="Re-activate" type="object"
                            class="btn-primary"
                            invisible="status == 'active' or enrollment_state != 'active'"/>
                        <button name="action_transfer" string="Transfer" type="object"
                            invisible="status != 'active' or enrollment_state != 'active'"/>
                        <button name="action_pause" string="Pause" type="object"
                            invisible="status != 'active' or enrollment_state != 'active'"/>
                        <field name="status" widget="statusbar"
                            statusbar_visible="active,paused,transferred,withdrawn,graduated"
                            invisible="enrollment_state != 'active'"/>
                    </header>
                    <sheet>
                        <field name="photo" widget="image" class="oe_avatar"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(school_management.action_report_grade_sheet)d"
                                string="Grade Report" type="action"
                                class="oe_stat_button" icon="fa-file-text-o"/>
                            <button name="%(school_management.action_report_attendance)d"
                                string="Attendance" type="action"
                                class="oe_stat_button" icon="fa-calendar-check-o"/>
                            <button name="%(school_management.action_report_enrollment_certificate)d"
                                string="Certificate" type="action"
                                class="oe_stat_button" icon="fa-certificate"/>
                            <button class="oe_stat_button" icon="fa-file-text-o"
                                invisible="enrollment_state == 'active'">
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="checklist_pending_count"/>
                                    </span>
                                    <span class="o_stat_text">وثائق معلقة</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="student_code" class="oe_edit_only"/>
                            <h6><field name="student_code" readonly="1"/></h6>
                            <h1><field name="name" placeholder="Student Full Name"/></h1>
                        </div>
                        <group>
                            <group string="Personal Information">
                                <field name="gender"/>
                                <field name="birth_date"/>
                                <field name="age" readonly="1"/>
                                <field name="nationality"/>
                                <field name="national_id"/>
                            </group>
                            <group string="Academic Information">
                                <field name="class_id"/>
                                <field name="academic_year_id" readonly="1"/>
                                <field name="grade_level" readonly="1"/>
                                <field name="enrollment_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="متطلبات التسجيل" name="enrollment_checklist">
                                <field name="checklist_ids"
                                    context="{'default_student_id': id}">
                                    <tree editable="bottom"
                                        decoration-success="status in ('submitted','verified')"
                                        decoration-danger="status == 'pending' and is_required"
                                        decoration-muted="status == 'not_applicable'">
                                        <field name="requirement_name" readonly="1"/>
                                        <field name="is_required" readonly="1"/>
                                        <field name="status"/>
                                        <field name="document_file" filename="document_filename"/>
                                        <field name="document_filename" invisible="1"/>
                                        <field name="notes"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Contact &amp; Guardian">
                                <group>
                                    <group string="Guardian">
                                        <field name="guardian_id"/>
                                        <field name="guardian_name" readonly="1"/>
                                        <field name="guardian_phone" readonly="1"/>
                                    </group>
                                    <group string="Contact">
                                        <field name="email"/>
                                        <field name="phone"/>
                                        <field name="address"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Additional notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Student Kanban View -->
        <record id="view_student_kanban" model="ir.ui.view">
            <field name="name">school.student.kanban</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="class_id">
                    <field name="name"/>
                    <field name="student_code"/>
                    <field name="photo"/>
                    <field name="class_id"/>
                    <field name="status"/>
                    <field name="guardian_phone"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image me-1">
                                    <img t-att-src="kanban_image('school.student', 'photo', record.id.raw_value)"
                                        alt="Student" class="o_image_64_cover"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="student_code"/>
                                    </div>
                                    <div>
                                        <field name="status" widget="badge"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Student Search View -->
        <record id="view_student_search" model="ir.ui.view">
            <field name="name">school.student.search</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <search string="Search Students">
                    <field name="name"/>
                    <field name="student_code"/>
                    <field name="class_id"/>
                    <field name="school_id"/>
                    <field name="guardian_id"/>
                    <field name="national_id"/>
                    <filter string="Active" name="active" domain="[('status','=','active')]"/>
                    <filter string="Paused" name="paused" domain="[('status','=','paused')]"/>
                    <filter string="Withdrawn" name="withdrawn" domain="[('status','=','withdrawn')]"/>
                    <filter string="Transferred" name="transferred" domain="[('status','=','transferred')]"/>
                    <filter string="Male" name="male" domain="[('gender','=','male')]"/>
                    <filter string="Female" name="female" domain="[('gender','=','female')]"/>
                    <separator/>
                    <filter string="طلبات التسجيل المعلقة" name="pending_enrollment"
                        domain="[('enrollment_state','in',['new','pending_docs','pending_approval'])]"/>
                    <filter string="بانتظار الموافقة" name="pending_approval"
                        domain="[('enrollment_state','=','pending_approval')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="School" name="group_school" context="{'group_by': 'school_id'}"/>
                        <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                        <filter string="Grade" name="group_grade" context="{'group_by': 'grade_level'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Gender" name="group_gender" context="{'group_by': 'gender'}"/>
                        <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Student Action -->
        <record id="action_student" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">school.student</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="search_view_id" ref="view_student_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register your first student
                </p>
            </field>
        </record>

        <!-- Guardian List View -->
        <record id="view_guardian_list" model="ir.ui.view">
            <field name="name">school.guardian.list</field>
            <field name="model">school.guardian</field>
            <field name="arch" type="xml">
                <tree string="Guardians">
                    <field name="name"/>
                    <field name="relationship"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                    <field name="email"/>
                    <field name="student_count"/>
                </tree>
            </field>
        </record>

        <!-- Guardian Form View -->
        <record id="view_guardian_form" model="ir.ui.view">
            <field name="name">school.guardian.form</field>
            <field name="model">school.guardian</field>
            <field name="arch" type="xml">
                <form string="Guardian">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-child" type="object" name="action_view_students" invisible="1">
                                <field name="student_count" widget="statinfo" string="Children"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Guardian Full Name"/></h1>
                        </div>
                        <group>
                            <group string="Personal Information">
                                <field name="relationship"/>
                                <field name="national_id"/>
                            </group>
                            <group string="Contact">
                                <field name="phone"/>
                                <field name="mobile"/>
                                <field name="email"/>
                            </group>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                        <notebook>
                            <page string="Children">
                                <field name="student_ids" readonly="1">
                                    <tree>
                                        <field name="student_code"/>
                                        <field name="name"/>
                                        <field name="class_id"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Guardian Action -->
        <record id="action_guardian" model="ir.actions.act_window">
            <field name="name">Guardians</field>
            <field name="res_model">school.guardian</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first guardian
                </p>
            </field>
        </record>

    </data>
</odoo>
