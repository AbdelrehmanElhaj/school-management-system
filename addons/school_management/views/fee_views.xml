<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Fee Type Views -->
        <record id="view_fee_type_tree" model="ir.ui.view">
            <field name="name">school.fee.type.tree</field>
            <field name="model">school.fee.type</field>
            <field name="arch" type="xml">
                <tree string="Fee Types">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="default_amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_fee_type_form" model="ir.ui.view">
            <field name="name">school.fee.type.form</field>
            <field name="model">school.fee.type</field>
            <field name="arch" type="xml">
                <form string="Fee Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h6><field name="code" placeholder="Code"/></h6>
                            <h1><field name="name" placeholder="Fee Type Name"/></h1>
                        </div>
                        <group>
                            <field name="default_amount"/>
                            <field name="currency_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fee_type" model="ir.actions.act_window">
            <field name="name">Fee Types</field>
            <field name="res_model">school.fee.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Fee Tree View -->
        <record id="view_fee_tree" model="ir.ui.view">
            <field name="name">school.fee.tree</field>
            <field name="model">school.fee</field>
            <field name="arch" type="xml">
                <tree string="Fees"
                    decoration-danger="state == 'overdue'"
                    decoration-success="state == 'paid'"
                    decoration-warning="state == 'partial'"
                    decoration-muted="state == 'cancelled'">
                    <field name="fee_code"/>
                    <field name="student_id"/>
                    <field name="class_id"/>
                    <field name="fee_type_id"/>
                    <field name="term"/>
                    <field name="amount"/>
                    <field name="discount_amount" optional="hide"/>
                    <field name="paid_amount"/>
                    <field name="balance"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="due_date"/>
                    <field name="is_exempt" optional="hide"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Fee Form View -->
        <record id="view_fee_form" model="ir.ui.view">
            <field name="name">school.fee.form</field>
            <field name="model">school.fee</field>
            <field name="arch" type="xml">
                <form string="Student Fee">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_schedule_payments" string="جدولة الدفعات"
                            type="object"
                            invisible="state != 'draft' or payment_mode != 'single'"/>
                        <button name="action_register_payment" string="Register Payment"
                            type="object" class="btn-primary"
                            invisible="state not in ('due','partial','overdue')"/>
                        <button name="action_create_invoice" string="Create Invoice"
                            type="object"
                            invisible="state not in ('due','partial','overdue') or invoice_id != False"/>
                        <button name="action_send_reminder" string="Send Reminder"
                            type="object"
                            invisible="state not in ('due','partial','overdue')"/>
                        <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('paid','cancelled')"/>
                        <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,due,partial,paid"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money">
                                <field name="payment_count" widget="statinfo" string="Payments"/>
                            </button>
                            <button name="action_view_invoice" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Invoice</span>
                                    <span class="o_stat_value">
                                        <field name="invoice_state"/>
                                    </span>
                                </div>
                            </button>
                            <button name="%(school_management.action_report_fee_statement)d"
                                string="Fee Statement" type="action"
                                class="oe_stat_button" icon="fa-file-pdf-o"/>
                        </div>
                        <div class="oe_title">
                            <label for="fee_code"/>
                            <h6><field name="fee_code" readonly="1"/></h6>
                            <h1><field name="display_name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Student &amp; Fee">
                                <field name="student_id"/>
                                <field name="guardian_id" readonly="1"/>
                                <field name="class_id" readonly="1"/>
                                <field name="academic_year_id" readonly="1"/>
                                <field name="fee_type_id"/>
                                <field name="term"/>
                                <field name="payment_mode" widget="radio"/>
                            </group>
                            <group string="Financial">
                                <field name="currency_id"/>
                                <field name="amount"/>
                                <field name="discount_amount"/>
                                <field name="discount_reason" invisible="not discount_amount"/>
                                <field name="is_exempt"/>
                                <field name="paid_amount" readonly="1"/>
                                <field name="balance" readonly="1"/>
                                <field name="invoice_date"/>
                                <field name="due_date"/>
                                <field name="invoice_id" readonly="1" invisible="not invoice_id"/>
                                <field name="invoice_amount_residual" readonly="1" invisible="not invoice_id"/>
                            </group>
                        </group>
                        <notebook>
                            <!-- Installments tab (visible in installment mode) -->
                            <page string="جدول الدفعات" name="installments"
                                invisible="payment_mode != 'installments'">
                                <field name="installment_ids" readonly="state != 'draft'">
                                    <tree
                                        decoration-success="state == 'paid'"
                                        decoration-danger="state == 'overdue'"
                                        decoration-warning="state == 'partial'"
                                        decoration-muted="state == 'pending'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="amount"/>
                                        <field name="due_date"/>
                                        <field name="paid_amount"/>
                                        <field name="balance"/>
                                        <field name="state"/>
                                        <field name="currency_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Payments">
                                <field name="payment_ids" readonly="1">
                                    <tree decoration-success="state=='confirmed'"
                                          decoration-muted="state=='cancelled'">
                                        <field name="payment_code"/>
                                        <field name="payment_date"/>
                                        <field name="installment_id"
                                            invisible="parent.payment_mode != 'installments'"/>
                                        <field name="amount"/>
                                        <field name="payment_method"/>
                                        <field name="received_by"/>
                                        <field name="state"/>
                                        <field name="currency_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Fee Pivot View -->
        <record id="view_fee_pivot" model="ir.ui.view">
            <field name="name">school.fee.pivot</field>
            <field name="model">school.fee</field>
            <field name="arch" type="xml">
                <pivot string="Fee Analysis">
                    <field name="academic_year_id" type="row"/>
                    <field name="fee_type_id" type="col"/>
                    <field name="amount" type="measure"/>
                    <field name="paid_amount" type="measure"/>
                    <field name="balance" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Fee Graph View -->
        <record id="view_fee_graph" model="ir.ui.view">
            <field name="name">school.fee.graph</field>
            <field name="model">school.fee</field>
            <field name="arch" type="xml">
                <graph string="Fee Collection" type="bar">
                    <field name="fee_type_id" type="row"/>
                    <field name="amount" type="measure"/>
                    <field name="paid_amount" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Fee Search View -->
        <record id="view_fee_search" model="ir.ui.view">
            <field name="name">school.fee.search</field>
            <field name="model">school.fee</field>
            <field name="arch" type="xml">
                <search string="Search Fees">
                    <field name="student_id"/>
                    <field name="fee_type_id"/>
                    <field name="class_id"/>
                    <field name="fee_code"/>
                    <filter string="Due" name="due" domain="[('state','=','due')]"/>
                    <filter string="Overdue" name="overdue" domain="[('state','=','overdue')]"/>
                    <filter string="Partially Paid" name="partial" domain="[('state','=','partial')]"/>
                    <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                    <filter string="Unpaid" name="unpaid"
                        domain="[('state','in',['due','partial','overdue'])]"/>
                    <filter string="Exempt" name="exempt" domain="[('is_exempt','=',True)]"/>
                    <filter string="Discounted" name="discounted" domain="[('discount_amount','>',0)]"/>
                    <separator/>
                    <filter string="First Term" name="first" domain="[('term','=','first')]"/>
                    <filter string="Second Term" name="second" domain="[('term','=','second')]"/>
                    <filter string="Annual" name="annual" domain="[('term','=','annual')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                        <filter string="Fee Type" name="group_type" context="{'group_by': 'fee_type_id'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Term" name="group_term" context="{'group_by': 'term'}"/>
                        <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Fee Action -->
        <record id="action_fee" model="ir.actions.act_window">
            <field name="name">Student Fees</field>
            <field name="res_model">school.fee</field>
            <field name="view_mode">tree,form,pivot,graph</field>
            <field name="search_view_id" ref="view_fee_search"/>
            <field name="context">{'search_default_unpaid': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No fees created yet
                </p>
            </field>
        </record>

        <!-- Payment Tree View -->
        <record id="view_payment_tree" model="ir.ui.view">
            <field name="name">school.fee.payment.tree</field>
            <field name="model">school.fee.payment</field>
            <field name="arch" type="xml">
                <tree string="Payments"
                    decoration-success="state=='confirmed'"
                    decoration-muted="state=='cancelled'">
                    <field name="payment_code"/>
                    <field name="payment_date"/>
                    <field name="student_id"/>
                    <field name="fee_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="payment_method"/>
                    <field name="received_by"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Payment Form View -->
        <record id="view_payment_form" model="ir.ui.view">
            <field name="name">school.fee.payment.form</field>
            <field name="model">school.fee.payment</field>
            <field name="arch" type="xml">
                <form string="Payment Receipt">
                    <header>
                        <button name="action_confirm" string="Confirm Payment"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                        <button name="action_cancel" string="Cancel"
                            type="object" invisible="state == 'cancelled'"/>
                        <button name="action_draft" string="Reset" type="object"
                            invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(school_management.action_report_receipt)d"
                                string="Print Receipt" type="action"
                                class="oe_stat_button" icon="fa-print"
                                invisible="state != 'confirmed'"/>
                        </div>
                        <div class="oe_title">
                            <label for="payment_code"/>
                            <h6><field name="payment_code" readonly="1"/></h6>
                            <h1><field name="display_name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Payment Details">
                                <field name="fee_id"/>
                                <field name="student_id" readonly="1"/>
                                <field name="guardian_id" readonly="1"/>
                                <field name="payment_date"/>
                                <field name="received_by"/>
                            </group>
                            <group string="Amount">
                                <field name="currency_id"/>
                                <field name="amount"/>
                                <field name="payment_method"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Notes..."/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Payment Action -->
        <record id="action_payment" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="res_model">school.fee.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_confirmed': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No payments recorded yet
                </p>
            </field>
        </record>

        <!-- Payment Wizard -->
        <record id="view_payment_wizard_form" model="ir.ui.view">
            <field name="name">school.fee.payment.wizard.form</field>
            <field name="model">school.fee.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Register Payment">
                    <sheet>
                        <group>
                            <group string="Fee Information">
                                <field name="fee_id" readonly="1"/>
                                <field name="fee_payment_mode" invisible="1"/>
                                <field name="student_id" readonly="1"/>
                                <field name="fee_amount" readonly="1"/>
                                <field name="balance" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Payment">
                                <field name="installment_id"
                                    invisible="fee_payment_mode != 'installments'"
                                    options="{'no_create': True}"/>
                                <field name="installment_balance" readonly="1"
                                    invisible="fee_payment_mode != 'installments' or not installment_id"/>
                                <field name="amount"/>
                                <field name="payment_date"/>
                                <field name="payment_method"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Notes..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Register Payment"
                            type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
