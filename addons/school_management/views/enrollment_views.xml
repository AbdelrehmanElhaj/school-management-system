<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Enrollment Requirement Tree -->
        <record id="view_enrollment_requirement_tree" model="ir.ui.view">
            <field name="name">school.enrollment.requirement.tree</field>
            <field name="model">school.enrollment.requirement</field>
            <field name="arch" type="xml">
                <tree string="Enrollment Requirements" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="is_required"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Enrollment Requirement Form -->
        <record id="view_enrollment_requirement_form" model="ir.ui.view">
            <field name="name">school.enrollment.requirement.form</field>
            <field name="model">school.enrollment.requirement</field>
            <field name="arch" type="xml">
                <form string="Enrollment Requirement">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Requirement Name"/></h1>
                        </div>
                        <group>
                            <field name="sequence"/>
                            <field name="is_required"/>
                            <field name="active"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Enrollment Requirement Action -->
        <record id="action_enrollment_requirement" model="ir.actions.act_window">
            <field name="name">Enrollment Requirements</field>
            <field name="res_model">school.enrollment.requirement</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add enrollment requirements for new students
                </p>
            </field>
        </record>

        <!-- Fee Schedule Wizard Views -->
        <record id="view_fee_schedule_wizard_form" model="ir.ui.view">
            <field name="name">school.fee.schedule.wizard.form</field>
            <field name="model">school.fee.schedule.wizard</field>
            <field name="arch" type="xml">
                <form string="جدولة الدفعات">
                    <sheet>
                        <group>
                            <group string="إعدادات الجدولة">
                                <field name="fee_id" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="installment_count"/>
                                <field name="first_due_date"/>
                                <field name="interval"/>
                            </group>
                        </group>
                        <div class="text-center mb-3">
                            <button name="action_generate" string="إنشاء تلقائي"
                                type="object" class="btn-primary"/>
                        </div>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="amount"/>
                                <field name="due_date"/>
                                <field name="currency_id" invisible="1"/>
                            </tree>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_apply" string="حفظ الجدول"
                            type="object" class="btn-primary"/>
                        <button string="إلغاء" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
