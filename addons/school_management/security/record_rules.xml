<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Teacher sees only students in their assigned classes -->
        <record id="rule_student_teacher" model="ir.rule">
            <field name="name">Student: Teacher sees own class students</field>
            <field name="model_id" ref="school_management.model_school_student"/>
            <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
            <field name="domain_force">[('class_id.teacher_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Parent sees only their children -->
        <record id="rule_student_parent" model="ir.rule">
            <field name="name">Student: Parent sees own children</field>
            <field name="model_id" ref="school_management.model_school_student"/>
            <field name="groups" eval="[(4, ref('school_management.group_school_parent'))]"/>
            <field name="domain_force">[('guardian_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

